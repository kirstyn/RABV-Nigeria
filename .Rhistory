plot.title = element_text(size = 12, face = "bold"),
panel.background = element_blank()
) +
ggtitle("A");p1
# ---------------------------
# Panel B: Kaduna LGAs
# ---------------------------
p2 <- ggplot() +
geom_sf(data = kaduna_lgas,
fill = "grey95",
colour = "white") +
geom_sf(data = study_lgas,
fill = "#D6604D",
colour = "black") +
geom_sf_text(data = kaduna_lgas %>%
filter(!NAME_2 %in% c("Lere", "Jema'a")),
aes(label = NAME_2),
size = 2.5,
check_overlap = TRUE) +
geom_sf_text(data = study_lgas,
aes(label = NAME_2),
size = 3,
fontface = "bold") +
annotation_scale(
location = "bl",
width_hint = 0.25
) +
annotation_north_arrow(
location = "tr",
style = north_arrow_fancy_orienteering(),
height = unit(1, "cm"),
width = unit(1, "cm")
) +
theme_void() +
theme(
plot.title = element_text(size = 12, face = "bold"),
)+
ggtitle("B");p2
# ---------------------------
# Combine
# ---------------------------
figure1 <- p1 +p2
figure1
ggsave(
"figures/Fig1_Kaduna_rabies_study_map.png",
figure1,
width = 12,
height = 5,
dpi = 600
)
ggsave(
"figures/Fig1_Kaduna_rabies_study_map.tiff",
figure1,
width = 12,
height = 5,
dpi = 600,
compression = "lzw"
)
